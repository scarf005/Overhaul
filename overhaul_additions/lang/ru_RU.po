msgstr[1] "сыворотки голема"
msgstr[2] "сывороток голема"

#: mutagen.json
msgid "드래곤 혈청"
msgid_plural "드래곤 혈청s"
msgstr[0] "сыворотка дракона"
msgstr[1] "сыворотки дракона"
msgstr[2] "сывороток дракона"

#. ~ Mutation class name
#: mutation_category.json
msgid "Fox"
msgstr "Лиса"

#. ~ Mutation class: Fox mutagen_message
#: mutation_category.json
msgid "산과 들을 뛰어다니고 싶다는 생각이 든다."
msgstr "Вам хочется носиться по горам и полям."

#. ~ Mutation class: Fox iv_message
#: mutation_category.json
msgid "혈관에 피가 흐를때마다 온 몸에서 털이 나는 느낌이 든다."
msgstr "С каждым ударом сердца вам кажется, будто всё тело обрастает шерстью."

#. ~ Mutation class: Fox Male memorial messsage
#. ~ Mutation class: Horse Male memorial messsage
#. ~ Mutation class: Golem Male memorial messsage
#. ~ Mutation class: Dragon Male memorial messsage
#: mutation_category.json
msgctxt "memorial_male"
msgid "어떤 것이든 문제가 없다."
msgstr "Вам всё нипочём."

#. ~ Mutation class: Fox Female memorial messsage
#. ~ Mutation class: Horse Female memorial messsage
#. ~ Mutation class: Golem Female memorial messsage
#. ~ Mutation class: Dragon Female memorial messsage
#: mutation_category.json
msgctxt "memorial_female"
msgid "어떤 것이든 문제가 없다."
msgstr "Вам всё нипочём."

#. ~ Mutation class name
#: mutation_category.json
msgid "Horse"
msgstr "Лошадь"

#. ~ Mutation class: Horse mutagen_message
#: mutation_category.json
msgid "다리가 강해진다는 느낌이 든다."
msgstr "Вам кажется, что ваши ноги становятся сильнее."

#. ~ Mutation class: Horse iv_message
#: mutation_category.json
msgid "심장이 빠르게 뛰며 어디든지 질주를 하고 싶다는 충동에 휩싸인다."
msgstr "Ваше сердце бешено колотится, и вас охватывает непреодолимое желание мчаться куда глаза глядят."

#. ~ Mutation class name
#: mutation_category.json
msgid "Golem"
msgstr "Голем"

#. ~ Mutation class: Golem mutagen_message
#: mutation_category.json
msgid "왠지 피부가 딱딱해지는 느낌이 든다."
msgstr "Вам почему-то кажется, что ваша кожа становится твёрже."

#. ~ Mutation class: Golem iv_message
#: mutation_category.json
msgid "흐르는 피 속에 둘맹이가 있는 느낌이 든다."
msgstr "Вам кажется, будто вместе с кровью по венам текут мелкие камешки."

#. ~ Mutation class name
#: mutation_category.json
msgid "Dragon"
msgstr "Дракон"

#. ~ Mutation class: Dragon mutagen_message
#: mutation_category.json
msgid "몸이 뜨거워지는 것 같다."
msgstr "Вам кажется, что ваше тело нагревается."

#. ~ Mutation class: Dragon iv_message
#: mutation_category.json
msgid "불타오르는 광기가... 휘몰아친다."
msgstr "Вас захлёстывает... огненное безумие."

#: mutations.json
msgid "나인테일"
msgstr "Девятихвостый лис"

#. ~ Description for 나인테일
#: mutations.json
msgid "당신은 9개나 되는 꼬리를 가졌습니다. 여차하면 침대 대신 덮고 잘 수 있을 정도로 폭신푹신하며 뛰어난 보온효과를 제공합니다. 다만 꼬리수가 많아진 탓에 회피능력 보너스가 기존보다 약간 감소합니다."
msgstr "У вас целых девять хвостов! Они настолько мягкие, пушистые и тёплые, что ими можно укрываться во сне вместо одеяла. Однако из-за такого количества хвостов бонус к уклонению немного снижен."

#: mutations.json
msgid "노란 솜털꼬리"
msgstr "Жёлтый пушистый хвост"

#. ~ Description for 노란 솜털꼬리
#: mutations.json
msgid "노란색의 길고 푹신한 털이 달린 꼬리가 생겼습니다. 이 꼬리는 몸의 균형을 잡는데 도움이 되고, 회피 능력을 대폭 향상시켜줍니다. 그렇지만 꼬리가 걸리적거려서 다리에 천 재질이 아닌 의복을 착용할 수 없게 됩니다."
msgstr "У вас вырос длинный жёлтый хвост, покрытый мягкой пушистой шерстью. Он помогает сохранять равновесие и значительно повышает способность уклоняться от атак. Однако из-за хвоста на ногах можно носить только тканевую одежду."

#: mutations.json
msgid "포니테일"
msgstr "Лошадиный хвост"

#. ~ Description for 포니테일
#: mutations.json
msgid "당신은 포니테일을 가지고 있습니다. 머리스타일이 아닌 진짜 포니테일을요. 회피에 보너스가 주어집니다. 그렇지만 꼬리가 걸리적거려서 다리에 천 재질이 아닌 의복을 착용할 수 없게 됩니다."
msgstr "У вас есть лошадиный хвост. И речь вовсе не о причёске, а о самом настоящем хвосте! Он повышает вашу способность уклоняться от атак, но из-за него на ногах можно носить только тканевую одежду."

#: mutations.json
msgid "Thick-Skinned"
msgstr "Толстая кожа"

#: mutations.json
msgid "돌 피부"
msgstr "Каменная кожа"

#. ~ Description for 돌 피부
#: mutations.json
msgid "당신의 피부는 사포로 문질러도 멀쩡할 정도로 매우 딱딱해졌습니다. 움직임이 약간 불편해지지만 받는 절단 피해를 감소시킵니다."
msgstr "Ваша кожа стала настолько твёрдой, что даже наждачная бумага не оставляет на ней следов. Двигаться стало немного труднее, зато теперь вы получаете меньше режущего урона."

#: mutations.json
msgid "암석 피부"
msgstr "Скальная кожа"

#. ~ Description for 암석 피부
#: mutations.json
msgid "당신의 피부는 생기를 잃었고 무기질에 가까워졌습니다. 움직임이 불편해지지만 받는 절단 피해를 크게 감소시키며 타격 피해 또한 감소합니다."
msgstr "Ваша кожа больше не похожа на живую ткань — скорее на минерал. Двигаться стало труднее, зато теперь вы получаете значительно меньше режущего урона, а также меньше дробящего."

#: mutations.json
msgid "Freakishly Huge"
msgstr "Исполинское тело"

#: mutations.json
msgid "노란 털가죽"
msgstr "Жёлтый мех"

#. ~ Description for 노란 털가죽
#: mutations.json
msgid "포근한 금빛 털이 온몸을 덮었습니다. 상당한 보온효과를 가집니다."
msgstr "Всё ваше тело покрылось мягкой золотистой шерстью, которая отлично сохраняет тепло."

#: mutations.json
msgid "용 비늘"
msgstr "Драконья чешуя"

#. ~ Description for 용 비늘
#: mutations.json
msgid "몸의 비늘이 붉은 빛을 띄며 더욱 단단해졌습니다. 이 비늘은 화염에 내성이 있고 높은 방어력을 가지고 있습니다. 그러나 움직이기 불편해서 민첩성이 2 감소하고 방해도도 약간 증가합니다. 또한 젖음 페널티를 크게 줄여줍니다."
msgstr "Чешуя на вашем теле приобрела красноватый оттенок и стала ещё прочнее. Она обеспечивает высокую защиту и устойчивость к огню. Однако из-за неё вам труднее двигаться: ловкость снижается на 2, а стеснение немного увеличивается. Кроме того, значительно уменьшаются штрафы от намокания."

#: mutations.json
msgid "여우 주둥이"
msgstr "Лисья морда"

#. ~ Description for 여우 주둥이
#: mutations.json
msgid "당신의 입이 뾰족한 여우 주둥이로 변했습니다."
msgstr "Ваш рот превратился в вытянутую, заострённую лисью морду."

#: mutations.json
msgid "말 주둥이"
msgstr "Лошадиная морда"

#. ~ Description for 말 주둥이
#: mutations.json
msgid "당신의 입은 진짜 말처럼 매우 길쭉하게 변했습니다."
msgstr "Ваша морда стала длинной и вытянутой, как у настоящей лошади."

#: mutations.json
msgid "용 머리"
msgstr "Драконья голова"

#. ~ Description for 용 머리
#: mutations.json
msgid "당신의 얼굴과 턱이 붉고, 크고, 강력하게 변화했습니다. 보기에는 징그럽지만 적을 물어뜯기에 탁월합니다."
msgstr "Ваше лицо и челюсти стали красными, огромными и невероятно мощными. Выглядят они жутковато, зато прекрасно подходят для того, чтобы разрывать врагов зубами."

#: mutations.json
msgid "%s(을)를 한웅큼 깨뭅니다."
msgstr "Вы впиваетесь зубами в цель (%s), вырывая кусок плоти."

#: mutations.json
msgid "%1$s(이)가 %2$s(을)를 한웅큼 깨뭅니다."
msgstr "%1$s впивается зубами в цель (%2$s), вырывая кусок плоти."

#: mutations.json
msgid "여우"
msgstr "Лиса"

#. ~ Description for 여우
#: mutations.json
msgid "문명이 멸망했지만 당신은 괜찮습니다. 산과 들, 숲이 당신의 집이니까요."
msgstr "Цивилизация погибла, но вас это не пугает. Ведь горы, поля и леса — ваш родной дом."

#: mutations.json
msgid "페가수스"
msgstr "Пегас"

#. ~ Description for 페가수스
#: mutations.json
msgid "앞으로 나아가고 전진하며 달립니니다. 그게 당신의 삶이니까요."
msgstr "Мчаться вперёд, не останавливаясь. Ведь в этом и заключается ваша жизнь."

#: mutations.json
msgid "골렘"
msgstr "Голем"

#. ~ Description for 골렘
#: mutations.json
msgid "당신은 누군가에게 자신이 살아있다고 감히 말할 수 없는 지경에 이르렀습니다"
msgstr "Теперь вы уже не осмеливаетесь утверждать, что живы"

#: mutations.json
msgid "드래곤"
msgstr "Дракон"

#. ~ Description for 드래곤
#: mutations.json
msgid "그 어떤 것도... 당신을 쉬이 불태우거나 쓰러뜨릴 수 없을 것입니다."
msgstr "Ничто не сможет... так просто сжечь вас или повергнуть наземь."

#: mutations.json
msgid "여우 귀"
msgstr "Лисьи уши"

#. ~ Description for 여우 귀
#: mutations.json
msgid "당신의 귀는 뾰족하고 매우 눈에 띕니다. 소리를 듣는데 탁월합니다."
msgstr "Ваши уши стали заострёнными и очень заметными. Теперь у вас превосходный слух."

#: mutations.json
msgid "토끼 귀"
msgstr "Кроличьи уши"

#. ~ Description for 토끼 귀
#: mutations.json
msgid "이 엄청나게 길쭉한 귀는... 마치 토끼가 된 느낌입니다. 보기에 좋고 소리를 듣는데 큰 도움이 되지만, 일반적인 장비를 머리에 착용할 수 없게 됩니다."
msgstr "Ваши уши стали невероятно длинными... Словно вы превратились в кролика! Они прекрасно выглядят и значительно улучшают слух, но теперь вы не можете носить на голове обычное снаряжение."

#: mutations.json
msgid "말 귀"
msgstr "Лошадиные уши"

#. ~ Description for 말 귀
#: mutations.json
msgid "당신의 귀는 작지만 모양새 있는 말의 귀가 되었습니다. 소리를 듣는데 도움이 됩니다."
msgstr "Ваши уши стали небольшими и изящными, как у лошади. Теперь вы лучше слышите."

#: mutations.json
msgid "신화적 매력"
msgstr "Мифическое обаяние"

#. ~ Description for 신화적 매력
#: mutations.json
msgid "당신은 이야기 속에서나 나올법한 미모를 가졌습니다. 누구라도 당신에게 호의를 가지지 않고는 못 배길겁니다."
msgstr "Вы обладаете красотой, о которой слагают легенды. Никто не сможет устоять перед вашим очарованием."

#: mutations.json
msgid "말의 민첩성"
msgstr "Лошадиная проворность"

#. ~ Description for 말의 민첩성
#: mutations.json
msgid "당신은 달리기 위해 존재합니다. 민첩성 +5"
msgstr "Вы рождены для бега. Ловкость +5"

#: mutations.json
msgid "골렘의 둔함"
msgstr "Неповоротливость голема"

#. ~ Description for 골렘의 둔함
#: mutations.json
msgid "몸이 이상하리만치 둔해진 느낌입니다. 그대신 힘이 강해진 느낌도 함께 듭니다. 체력 +2, 민첩성 -2"
msgstr "Ваше тело стало непривычно неповоротливым, но вместе с тем вы чувствуете прилив сил. Сила +2, ловкость −2"

#: mutations.json
msgid "여우의 교활함"
msgstr "Лисья хитрость"

#. ~ Description for 여우의 교활함
#: mutations.json
msgid "어째서인지 머리가 매우 좋아진 느낌입니다. 지능 +5"
msgstr "По какой-то причине вы чувствуете, что стали гораздо сообразительнее. Интеллект +5"

#: mutations.json
msgid "Reptilian Healing"
msgstr "Регенерация рептилии"

