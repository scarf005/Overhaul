#: armor.json
msgid "무녀복"
msgid_plural "무녀복s"
msgstr[0] "одеяние мико"
msgstr[1] "одеяния мико"
msgstr[2] "одеяний мико"

#. ~ Description for 무녀복
#: armor.json
msgid "일본 신토신앙의 예복, 실용성보다는 외견에 치중되어 있습니다."
msgstr "Церемониальное облачение служительницы японского синтоистского храма. При его создании больше внимания уделялось внешнему виду, чем практичности."

#: armor.json
msgid "생존용 무녀복"
msgid_plural "생존용 무녀복s"
msgstr[0] "одеяние мико для выживания"
msgstr[1] "одеяния мико для выживания"
msgstr[2] "одеяний мико для выживания"

#. ~ Description for 생존용 무녀복
#: armor.json
msgid "일본 신토신앙의 예복, 외견을 최대한 보존한채 케블라와 노멕스를 덧대고 주머니를 만들어 실용성을 늘렸습니다."
msgstr "Церемониальное облачение служительницы синтоистского храма, приспособленное для выживания. Его внешний вид практически не изменился, зато благодаря вставкам из кевлара и номекса и дополнительным карманам оно стало гораздо практичнее."

#: armor.json
msgid "개선된 보안경"
msgid_plural "개선된 보안경s"
msgstr[0] "улучшенные защитные очки"
msgstr[1] "улучшенных защитных очков"
msgstr[2] "улучшенных защитных очков"

#. ~ Description for 개선된 보안경
#: armor.json
msgid "기존의 보안경을 조금 더 크게하면서 방어력도 개선했습니다."
msgstr "Увеличенная версия обычных защитных очков с улучшенными защитными свойствами."

#: armor.json
msgid "리본"
msgid_plural "리본s"
msgstr[0] "бант"
msgstr[1] "банта"
msgstr[2] "бантов"

#. ~ Description for 리본
#: armor.json
msgid "끈을 간단이 꼬아서 만든 장식용 리본입니다."
msgstr "Простой декоративный бант из переплетённых лент."

#: armor.json
msgid "꽃 비녀"
msgid_plural "꽃 비녀s"
msgstr[0] "цветочная шпилька"
msgstr[1] "цветочные шпильки"
msgstr[2] "цветочных шпилек"

#. ~ Description for 꽃 비녀
#: armor.json
msgid "짧은 작대기에 조화와 끈을 단 장식용 비녀."
msgstr "Декоративная шпилька для волос, украшенная искусственным цветком и лентами."

#: armor.json
msgid "자금관"
msgid_plural "자금관s"
msgstr[0] "цзыцзиньгуань"
msgstr[1] "цзыцзиньгуаня"
msgstr[2] "цзыцзиньгуаней"

#. ~ Description for 자금관
#: armor.json
msgid "중국의 전통 모자. 과거 어떠한 중국의 무장이 머리에 쓰고다녀 매우 유명한 모자다."
msgstr "Традиционный китайский головной убор, получивший широкую известность благодаря одному китайскому военачальнику, который когда-то его носил."

#: armor.json
msgid "아얌"
msgid_plural "아얌s"
msgstr[0] "аям"
msgstr[1] "аяма"
msgstr[2] "аямов"

#. ~ Description for 아얌
#: armor.json
msgid "조선의 전통 모자. 여성들이 쓰던 방한모. 방어성능은 기대할 수 없다."
msgstr "Традиционный корейский женский головной убор для защиты от холода. На какую-либо защиту в бою рассчитывать не приходится."

#: armor.json
msgid "붉은 관"
msgid_plural "붉은 관s"
msgstr[0] "красный венец"
msgstr[1] "красных венца"
msgstr[2] "красных венцов"

#. ~ Description for 붉은 관
#: armor.json
msgid "신비한 느낌이 감도는 붉은색 관."
msgstr "Красный венец, окутанный таинственной аурой."

#: armor.json
msgid "푸른 관"
msgid_plural "푸른 관s"
msgstr[0] "синий венец"
msgstr[1] "синих венца"
msgstr[2] "синих венцов"

#. ~ Description for 푸른 관
#: armor.json
msgid "신비한 느낌이 감도는 파란색 관."
msgstr "Синий венец, окутанный таинственной аурой."

#: armor.json
msgid "한복"
msgid_plural "한복s"
msgstr[0] "ханбок"
msgstr[1] "ханбока"
msgstr[2] "ханбоков"

#. ~ Description for 한복
#: armor.json
msgid "동북아시아 한국이라 불리는 나라의 전통의상"
msgstr "Традиционная одежда Кореи — страны, расположенной в Северо-Восточной Азии"

#: armor.json
msgid "생존용 한복"
msgid_plural "생존용 한복s"
msgstr[0] "ханбок для выживания"
msgstr[1] "ханбока для выживания"
msgstr[2] "ханбоков для выживания"

#. ~ Description for 생존용 한복
#: armor.json
msgid "동북아시아 한국이라 불리는 나라의 전통의상, 외견을 최대한 보존한채 필요없는 부분을 잘라내고, 케블라를 덧댄 뒤에 주머니를 만들어 실용성을 늘렸습니다."
msgstr "Традиционная корейская одежда, приспособленная для выживания. Её внешний вид постарались максимально сохранить, убрав лишние детали, усилив кевларом и добавив карманы для большей практичности."

#: armor.json
msgid "하이테크 보안경 (꺼짐)"
msgid_plural "하이테크 보안경 (꺼짐)s"
msgstr[0] "высокотехнологичные защитные очки (выкл.)"
msgstr[1] "высокотехнологичных защитных очков (выкл.)"
msgstr[2] "высокотехнологичных защитных очков (выкл.)"

#. ~ Use action msg for 하이테크 보안경 (꺼짐).
#: armor.json
msgid "하이테크 보안경을 가동시켰다."
msgstr "Вы включили высокотехнологичные защитные очки."

#. ~ Use action need_charges_msg for 하이테크 보안경 (꺼짐).
#: armor.json
msgid "하이테크 보안경에 배터리가 없다."
msgstr "В высокотехнологичных защитных очках нет батареи."

#. ~ Description for 하이테크 보안경 (꺼짐)
#: armor.json
msgid "시력보정 기능과 멀리볼수 있는 기능, 그리고 밝은 빛에 눈을 보호하는 기능이 내장되어 있는 최첨단 보안경. 사용하면 꽤 밝은 빛이 켜집니다."
msgstr "Высокотехнологичные защитные очки со встроенными функциями коррекции зрения, увеличения удалённых объектов и защиты глаз от яркого света. При активации включается довольно яркая подсветка."

#: armor.json
msgid "하이테크 보안경 (켜짐)"
msgid_plural "하이테크 보안경 (켜짐)s"
msgstr[0] "высокотехнологичные защитные очки (вкл.)"
msgstr[1] "высокотехнологичных защитных очков (вкл.)"
msgstr[2] "высокотехнологичных защитных очков (вкл.)"

#. ~ Use action menu_text for 하이테크 보안경 (켜짐).
#: armor.json
msgid "끄기"
msgstr "Выключить"

#. ~ Use action msg for 하이테크 보안경 (켜짐).
#: armor.json
msgid "하이테크 보안경을 껐다."
msgstr "Вы выключили высокотехнологичные защитные очки."

#. ~ Description for 하이테크 보안경 (켜짐)
#: armor.json
msgid "시력보정 기능과 멀리볼수 있는 기능, 그리고 매우 밝은 빛에 눈을 보호하는 기능이 내장되어 있는 최첨단 보안경. 현재 빛이 나오고 있는 상태입니다."
msgstr "Высокотехнологичные защитные очки со встроенными функциями коррекции зрения, увеличения удалённых объектов и защиты глаз от очень яркого света. В данный момент подсветка включена."

#: armor.json
msgid "필터 마스크(XL)"
msgid_plural "필터 마스크(XL)s"
msgstr[0] "фильтрующая маска (XL)"
msgstr[1] "фильтрующие маски (XL)"
msgstr[2] "фильтрующих масок (XL)"

#. ~ Description for 필터 마스크(XL)
#: armor.json
msgid "필터마스크를 이어붙여서 대형화시켰습니다. 이 정도 사이즈라면 어떤 입에도 잘 맞을거 같습니다."
msgstr "Несколько фильтрующих масок соединили вместе, получив одну большую. Похоже, теперь она подойдёт для пасти любого размера."

#: armor.json
msgid "선녀의 스카프"
msgid_plural "선녀의 스카프s"
msgstr[0] "шарф небесной девы"
msgstr[1] "шарфа небесной девы"
msgstr[2] "шарфов небесной девы"

#. ~ Description for 선녀의 스카프
#: armor.json
msgid "날개옷과 비슷한 느낌의 반투명한 천."
msgstr "Полупрозрачная ткань, напоминающая одеяние небесной девы."

#: armor.json
msgid "강철 카이트실드"
msgid_plural "강철 카이트실드s"
msgstr[0] "стальной каплевидный щит"
msgstr[1] "стальных каплевидных щита"
msgstr[2] "стальных каплевидных щитов"

#. ~ Description for 강철 카이트실드
#: armor.json
msgid "위는 둥글고 아래는 뾰족한 형태의 대형 방패, 현대의 강철로 만들었기 때문에 전통적인 방식의 카이트실드보다는 훨씬 튼튼하지만 대신 굉장히 무겁다."
msgstr "Большой щит с закруглённым верхом и заострённым низом. Изготовлен из современной стали, поэтому гораздо прочнее традиционных каплевидных щитов, но при этом чрезвычайно тяжёлый."

#: books.json
msgid "Tyep2 : 전설의 생명체 재현"
msgid_plural "Tyep2 : 전설의 생명체 재현s"
msgstr[0] "«Тип 2: Воссоздание легендарных существ»"
msgstr[1] "книги «Тип 2: Воссоздание легендарных существ»"
msgstr[2] "книг «Тип 2: Воссоздание легендарных существ»"

#. ~ Description for Tyep2 : 전설의 생명체 재현
#: books.json
msgid "신화속의 짐승을 구현해보고자하는 과학자들의 연구서."
msgstr "Научный труд, посвящённый попыткам учёных воссоздать мифических животных."

#: modinfo.json
msgid "Overhaul Tileset/Additions"
msgstr "Тайлсет Overhaul (дополнения)"

#. ~ Description for Overhaul Tileset/Additions
#: modinfo.json
msgid "Overhaul Tileset용 외형, 변이, 아이템, 차량 부품 추가 모드입니다."
msgstr "Мод, добавляющий новые варианты внешности, мутации, предметы и детали транспорта для тайлсета Overhaul."

#: mutagen.json
msgid "여우 뮤타젠"
msgid_plural "여우 뮤타젠s"
msgstr[0] "мутаген лисы"
msgstr[1] "мутагена лисы"
msgstr[2] "мутагенов лисы"

